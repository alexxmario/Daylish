        {
          "name": "olive oil",
          "grams": 7,
          "displayQuantity": "1½ tsp",
          "preparation": null,
          "optional": false
        },
        {
          "name": "ground cumin",
          "grams": 2,
          "displayQuantity": "1 tsp",
          "preparation": null,
          "optional": false
        },
        {
          "name": "smoked paprika",
          "grams": 2,
          "displayQuantity": "1 tsp",
          "preparation": null,
          "optional": false
