      ],
      "steps": [
        {
          "order": 1,
          "instruction": "Rinse the white rice until the water runs clear, then simmer in twice its volume of water with a pinch of the salt until tender and the water has gone.",
          "durationMinutes": 12,
          "isPassive": true
        },
        {
          "order": 2,
          "instruction": "While the rice cooks, dice the tomatoes and red onion, shred the lettuce and chop the coriander. Toss the tomatoes and onion with half the lime juice and a little salt to make a rough salsa.",
          "durationMinutes": 8,
          "isPassive": false
        },
        {
          "order": 3,
          "instruction": "Slice the chicken breast and toss it with the ground cumin, smoked paprika and remaining salt.",
          "durationMinutes": 4,
          "isPassive": false
        },
        {
          "order": 4,
          "instruction": "Heat the olive oil in a frying pan over high heat and cook the chicken until browned at the edges and cooked through — it should no longer be pink in the centre.",
          "durationMinutes": 8,
          "isPassive": false
        },
        {
          "order": 5,
          "instruction": "Warm the black beans through in the same pan for a minute, scraping up any browned bits.",
          "durationMinutes": 1,
          "isPassive": false
        },
        {
          "order": 6,
          "instruction": "Build the bowls: rice first, then beans, chicken, salsa and lettuce in separate sections. Finish with the coriander and the rest of the lime juice.",
          "durationMinutes": 3,
          "isPassive": false
        }
      ],
      "storageNotes": "Keeps 3 days in the fridge. Store the lettuce separately and add it cold; reheat the rice, beans and chicken together.",
      "fridgeDays": 3,
      "freezerMonths": 1
