      "steps": [
        {
          "order": 1,
          "instruction": "Dice the onion and red bell pepper, mince the garlic and chop the parsley. Drain the chickpeas and cut the tofu into large pieces — bigger than you think, so they hold together in the sauce.",
          "durationMinutes": 10,
          "isPassive": false
        },
        {
          "order": 2,
          "instruction": "Heat the olive oil in a wide frying pan over medium heat. Cook the onion, bell pepper and salt until the onion is soft and translucent.",
          "durationMinutes": 8,
          "isPassive": false
        },
        {
          "order": 3,
          "instruction": "Stir in the garlic, ground cumin and smoked paprika and cook for a minute until fragrant.",
          "durationMinutes": 1,
          "isPassive": false
        },
        {
          "order": 4,
          "instruction": "Add the tomatoes and chickpeas, crushing a few of the chickpeas against the side of the pan to thicken the sauce. Simmer uncovered until thick and glossy.",
          "durationMinutes": 10,
          "isPassive": true
        },
        {
          "order": 5,
          "instruction": "Wilt in the spinach, then nestle the tofu into the sauce in the wells where the eggs would go. Spoon a little sauce over each piece and warm through gently.",
