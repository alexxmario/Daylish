node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store

# Environment — never commit keys
.env
.env.local
.env.*.local

# Signing and service keys. This repository is public, and Apple hands these
# out as plain files that land in ~/Downloads and get dragged into the project
# folder — the In-App Purchase key (SubscriptionKey_*.p8) and the App Store
# Connect API key (AuthKey_*.p8) both download exactly once and cannot be
# re-downloaded, so a leak means revoke, regenerate, and reconfigure
# RevenueCat. None of these belong in git under any name.
*.p8
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision

# Pipeline run artefacts
.last-batch.json
services/recipe-pipeline/.last-batch.json

# Generated, but committed on purpose so the app bundle can read them:
#   packages/db/migrations/*.sql
#   packages/db/src/migrations.generated.ts
