{
  "name": "@daylish/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --import=./test/register-hooks.mjs --test \"test/*.test.ts\"",
    "test:live": "DAYLISH_LIVE_TESTS=1 node --experimental-strip-types --experimental-test-module-mocks --import=./test/register-hooks.mjs --test \"test/live-barcode.test.ts\"",
    "seed:recipes": "node scripts/build-recipe-seed.mjs",
    "photos:map": "node scripts/build-photo-map.mjs",
    "seed:free": "node scripts/build-free-recipes.mjs"
  },
  "dependencies": {
    "@daylish/core": "*",
    "@daylish/db": "*",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@supabase/supabase-js": "^2.110.9",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^10.5.0",
    "react-native-purchases-ui": "^10.5.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
