{
  "name": "daylish",
  "version": "0.1.0",
  "private": true,
  "description": "Daylish: Meals, Macros & Recipes — your whole day, delicious.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start -w @daylish/mobile --",
    "pipeline": "npm run start -w @daylish/recipe-pipeline --",
    "test:rls": "node --test supabase/test/rls.test.mjs",
    "verify:delete-account": "node supabase/scripts/verify-delete-account.mjs",
    "verify:sync": "node supabase/scripts/verify-sync.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "supabase": "^2.111.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "react": "19.1.0"
  }
}
